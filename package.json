{
  "name": "screenshot-basic",
  "version": "1.0.0",
  "description": "Updated version of screenshot-basic for FiveM Enhanced by @manugo-dev",
  "main": "index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:client": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack --config client.config.js",
    "build:server": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack --config server.config.js",
    "build:ui": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack --config ui.config.js",
    "build": "npm run clean && npm run build:client && npm run build:server && npm run build:ui",
    "watch:client": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack --watch --config client.config.js",
    "watch:server": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack --watch --config server.config.js",
    "watch:ui": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack --watch --config ui.config.js"
  },
  "author": "@citizenfx and @manugo-dev",
  "license": "MIT",
  "overrides": {
    "@types/express": "4.17.13",
    "@types/express-serve-static-core": "4.17.31",
    "@types/http-assert": "1.2.1",
    "@types/keygrip": "1.0.2"
  },
  "dependencies": {
    "@citizenfx/client": "^1.0.3404-1",
    "@citizenfx/http-wrapper": "^0.2.2",
    "@citizenfx/server": "^1.0.3404-1",
    "@citizenfx/three": "^0.100.0",
    "@types/koa": "2.11.6",
    "@types/koa-router": "7.4.1",
    "@types/mv": "2.1.0",
    "@types/node": "10.12.18",
    "@types/uuid": "8.3.0",
    "html-webpack-inline-source-plugin": "^0.0.10",
    "html-webpack-plugin": "^3.2.0",
    "koa": "^2.6.2",
    "koa-body": "^4.0.6",
    "koa-router": "^7.4.0",
    "mv": "^2.1.1",
    "ts-loader": "^5.3.3",
    "typescript": "3.2.2",
    "uuid": "^3.3.2",
    "cross-env": "^7.0.3",
    "webpack": "4.28.4",
    "webpack-cli": "^3.3.12"
  }
}
